# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=8787
# Exact origin the frontend is served from (no trailing slash). Locks down CORS.
CORS_ORIGIN=https://sivanagireddyy.github.io

# --- JWT (app login) ---
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Microsoft Graph (Azure AD App Registration, APPLICATION permissions) ---
# See server/README.md for exact step-by-step setup of these three values.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# The SharePoint "Anyone with the link can edit" sharing URL to the Excel file.
# Paste the link exactly as SharePoint gives it to you.
SHAREPOINT_FILE_URL=

# How often (ms) the backend refreshes its own cache from SharePoint in the background.
SHEET_POLL_INTERVAL_MS=30000
