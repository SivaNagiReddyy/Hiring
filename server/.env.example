# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=8787
# Exact origin the frontend is served from (no trailing slash). Locks down CORS.
CORS_ORIGIN=https://sivanagireddyy.github.io

# --- JWT (app login) ---
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Google Drive (a service account, see server/README.md for setup) ---
GOOGLE_CLIENT_EMAIL=
# Paste the private_key value from the downloaded JSON key file exactly as
# given (it contains literal \n sequences, leave them as \n, do not turn
# them into real newlines).
GOOGLE_PRIVATE_KEY=

# The Excel file's normal Google Drive share link (or just its file id).
GOOGLE_DRIVE_FILE_URL=

# How often (ms) the backend refreshes its own cache from Drive in the background.
SHEET_POLL_INTERVAL_MS=30000
